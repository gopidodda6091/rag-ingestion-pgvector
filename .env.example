# Copy to .env. Values below are for the local docker compose database only.
POSTGRES_USER=rag
POSTGRES_PASSWORD=rag
POSTGRES_DB=rag
PG_PORT=5432
PG_DSN=postgresql://rag:rag@localhost:5432/rag
PG_SCHEMA=rag
# Key for the audit-log HMAC of redacted values. Set your own outside local dev.
REDACTION_HMAC_KEY=change-me-local-dev-only
# 1 = sentence-transformers all-MiniLM-L6-v2 (needs requirements-model.txt); 0 = hashing fallback
USE_ST_MODEL=0
OUTPUT_DIR=output
